# Caddy terminates HTTPS (automatic Let's Encrypt certificates) and proxies to the app.
# DOMAIN comes from the environment; see deploy/docker-compose.prod.yml.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy web:8000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
