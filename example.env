# Core app
# IMPORTANT: set a strong, random SECRET_KEY before deploying. The app warns when the
# insecure default is used in a non-debug process. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DATABASE_URL=sqlite:///instance/ankigpt.db
# Neon: paste the pooled connection URL from the project's Connect dialog.
# DATABASE_URL=postgresql://ROLE:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Optional direct URL for the one-time migration (never commit real credentials).
# DATABASE_URL_UNPOOLED=postgresql://ROLE:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Workspace access always requires sign-in; shared demo mode is no longer supported.

# Set to true when serving over HTTPS so the session cookie is marked Secure.
SESSION_COOKIE_SECURE=false

# Uploads and limits
UPLOAD_MAX_MB=50
UPLOAD_FOLDER=instance/uploads
# Hard cap on pasted/extracted source length (characters) to bound LLM cost. 0 disables.
MAX_SOURCE_CHARS=400000

# OpenRouter
OPENROUTER_API_KEY=
# Default model for every pipeline role. Check your OpenRouter account for model
# availability and current billing; each role can be overridden independently.
OPENROUTER_MODEL=openai/gpt-5.6-luna
# Optional per-role overrides (mapper, planner, worker, critic, reconcile, vision).
# e.g. a stronger planner:  OPENROUTER_MODEL_PLANNER=openai/gpt-5.6-terra
OPENROUTER_MODEL_PLANNER=
OPENROUTER_MODEL_MAPPER=
OPENROUTER_MODEL_WORKER=
OPENROUTER_MODEL_CRITIC=
OPENROUTER_MODEL_RECONCILE=
OPENROUTER_MODEL_VISION=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Reasoning effort per role (low | medium | high). Leave empty to omit the parameter.
OPENROUTER_REASONING_PLANNER=medium
OPENROUTER_REASONING_MAPPER=low
OPENROUTER_REASONING_WORKER=low
OPENROUTER_REASONING_CRITIC=low
OPENROUTER_REASONING_RECONCILE=low
OPENROUTER_REASONING_VISION=low
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AnkiGPT
OPENROUTER_TIMEOUT_SECONDS=180
OPENROUTER_MAX_TOKENS=16000

# Pipeline
PIPELINE_MAX_WORKERS=6
PIPELINE_CRITIC_ENABLED=true
PIPELINE_COVERAGE_ENABLED=true
PIPELINE_EMBED_DEDUPE_ENABLED=true
PIPELINE_CACHE_ENABLED=true
PIPELINE_FIGURES_ENABLED=true
PIPELINE_MAX_FIGURES=24
