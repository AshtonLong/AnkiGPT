# Core app
# IMPORTANT: set a strong, random SECRET_KEY before deploying. The app warns when the
# insecure default is used in a non-debug process. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DATABASE_URL=sqlite:///instance/ankigpt.db
AUTH_REQUIRED=true

# Set to true when serving over HTTPS so the session cookie is marked Secure.
SESSION_COOKIE_SECURE=false

# Uploads and limits
UPLOAD_MAX_MB=50
UPLOAD_FOLDER=instance/uploads
# Hard cap on pasted/extracted source length (characters) to bound LLM cost. 0 disables.
MAX_SOURCE_CHARS=200000

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AnkiGPT
OPENROUTER_MAX_TOKENS=4000

# Celery (set eager=false and broker/backend URLs for async workers)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_ALWAYS_EAGER=true
