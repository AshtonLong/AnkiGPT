# Core app
# IMPORTANT: set a strong, random SECRET_KEY before deploying. The app warns when the
# insecure default is used in a non-debug process. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY also encrypts the OpenRouter keys users save, so keep it stable: changing
# it makes every saved key unreadable and users have to enter theirs again.
SECRET_KEY=change-me
# SQLite only. A relative path lives in the instance folder (the Docker volume).
DATABASE_URL=sqlite:///instance/ankigpt.db
# Workspace access always requires sign-in; shared demo mode is no longer supported.

# Production domain, used by deploy/docker-compose.prod.yml (Caddy + HTTPS).
# DOMAIN=yourdomain.com
# Behind a reverse proxy, trust this many X-Forwarded-* hops (the prod compose sets 1).
PROXY_FIX_HOPS=0

# Set to true when serving over HTTPS so the session cookie is marked Secure.
SESSION_COOKIE_SECURE=false

# Uploads and limits
UPLOAD_MAX_MB=50
UPLOAD_FOLDER=instance/uploads
# Hard cap on pasted/extracted source length (characters) to bound LLM cost. 0 disables.
MAX_SOURCE_CHARS=400000

# Password-reset email over SMTP. Resend: host smtp.resend.com, port 465, user "resend",
# password = API key. Unset, reset links are written to the server log instead.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM=

# Shown on /terms, /privacy and the site footer.
LEGAL_NAME=AnkiGPT
SUPPORT_EMAIL=
LEGAL_JURISDICTION=Canada

# OpenRouter
# Each user adds their own key under My profile, so this can stay empty. If set, it is
# the fallback for accounts without a key: fine for a private install, but on a public
# server every such account would spend your credits.
OPENROUTER_API_KEY=
# Default model for every pipeline role. Check OpenRouter for model availability and
# current prices; each role can be overridden independently. Users can pick another
# model under My profile -> AI model, which then runs every role of their runs.
OPENROUTER_MODEL=openai/gpt-6-luna
# Optional per-role overrides (mapper, cheatsheet, planner, worker, critic, reconcile, vision).
# e.g. a stronger planner:  OPENROUTER_MODEL_PLANNER=openai/gpt-6-sol
OPENROUTER_MODEL_PLANNER=
OPENROUTER_MODEL_MAPPER=
OPENROUTER_MODEL_CHEATSHEET=
OPENROUTER_MODEL_WORKER=
OPENROUTER_MODEL_CRITIC=
OPENROUTER_MODEL_RECONCILE=
OPENROUTER_MODEL_VISION=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Default reasoning effort per role (none | minimal | low | medium | high | xhigh | max).
# Leave empty to omit the parameter. A level the model in use lacks is sent as the next
# one up that it has. Users can set their own per agent under My profile -> Advanced.
OPENROUTER_REASONING_PLANNER=medium
OPENROUTER_REASONING_MAPPER=low
OPENROUTER_REASONING_CHEATSHEET=medium
OPENROUTER_REASONING_WORKER=low
OPENROUTER_REASONING_CRITIC=low
OPENROUTER_REASONING_RECONCILE=low
OPENROUTER_REASONING_VISION=low
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AnkiGPT
OPENROUTER_TIMEOUT_SECONDS=180
OPENROUTER_MAX_TOKENS=16000

# Pipeline
PIPELINE_MAX_WORKERS=6
PIPELINE_CRITIC_ENABLED=true
PIPELINE_COVERAGE_ENABLED=true
PIPELINE_EMBED_DEDUPE_ENABLED=true
PIPELINE_CACHE_ENABLED=true
PIPELINE_FIGURES_ENABLED=true
PIPELINE_MAX_FIGURES=24
